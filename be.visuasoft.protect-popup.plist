<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>be.visuasoft.protect-popup</string>
    <key>ProgramArguments</key>
    <array>
        <!-- Pas JOUWNAAM aan naar je macOS-gebruikersnaam -->
        <string>/Users/JOUWNAAM/Applications/protect-popup/protect-popup</string>
        <string>/Users/JOUWNAAM/.config/protect-popup/config.json</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/tmp/protect-popup.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/protect-popup.log</string>
</dict>
</plist>
